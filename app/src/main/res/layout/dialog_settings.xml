<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Trading &amp; Risk Settings"
            android:textColor="@color/primary_cyan"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Manage paper capital, leverage &amp; trailing stops"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!-- Card: Capital & Position Size -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="8dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 ACCOUNT CAPITAL &amp; SIZING"
                    android:textColor="@color/primary_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Starting Capital -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Starting Capital (USD)"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etStartingBalance"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/bg_dark"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="10dp"
                    android:text="10000"
                    android:textColor="@color/neon_green"
                    android:textSize="13sp" />

                <!-- Position Size -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Trade Position Size (USD)"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etPositionSize"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/bg_dark"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="10dp"
                    android:text="500"
                    android:textColor="@color/text_white"
                    android:textSize="13sp" />

                <!-- Quick Take Profit Target -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="⚡ Quick Take Profit (Target USD Profit)"
                    android:textColor="@color/neon_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTargetProfit"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/bg_dark"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="10dp"
                    android:text="2.0"
                    android:textColor="@color/neon_green"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Automatically closes trade immediately when it reaches this profit (Default: $2.00)"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <!-- Leverage Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Futures Leverage (Multiplier)"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnLev1"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/card_border"
                        android:gravity="center"
                        android:text="1x"
                        android:textColor="@color/text_white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnLev3"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/card_border"
                        android:gravity="center"
                        android:text="3x"
                        android:textColor="@color/text_white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnLev5"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/primary_cyan"
                        android:gravity="center"
                        android:text="5x"
                        android:textColor="@color/bg_dark"
                        android:textStyle="bold"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnLev10"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/card_border"
                        android:gravity="center"
                        android:text="10x"
                        android:textColor="@color/text_white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnLev20"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:background="@color/card_border"
                        android:gravity="center"
                        android:text="20x"
                        android:textColor="@color/text_white"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Dynamic Risk & Trailing Stops -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="8dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ RISK &amp; TRAILING PROTECTION"
                    android:textColor="@color/primary_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Auto Break-Even Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBreakEven"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checked="true"
                    android:text="Auto Break-Even at +1.5%"
                    android:textColor="@color/text_white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Locks Stop-Loss to entry when price reaches +1.5% profit"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <!-- Trailing Stop-Loss Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTrailing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="Dynamic Trailing Stop (1.2%)"
                    android:textColor="@color/text_white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trails 1.2% behind the peak once trade exceeds +2.0% profit"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reset Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetPaper"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🔄 Reset Account Balance &amp; History"
            android:textColor="@color/neon_red"
            android:textSize="12sp"
            app:strokeColor="@color/neon_red" />

        <!-- Dialog Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_cyan"
                android:text="💾 Save Settings"
                android:textColor="@color/bg_dark"
                android:textStyle="bold"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
