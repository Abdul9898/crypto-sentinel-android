<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvChartTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📈 JCT / USDT"
            android:textColor="@color/primary_cyan"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChartStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/card_border"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="SHORT ACTIVE"
            android:textColor="@color/neon_red"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Timeframe Interval Selector (3 Monitored Timeframes) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Interval:"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnTf5m"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@color/primary_cyan"
            android:gravity="center"
            android:text="5m"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTf15m"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@color/card_border"
            android:gravity="center"
            android:text="15m"
            android:textColor="@color/text_white"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnTf1h"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:background="@color/card_border"
            android:gravity="center"
            android:text="1h"
            android:textColor="@color/text_white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 3-Timeframe MACD Live Monitor Bar -->
    <LinearLayout
        android:id="@+id/layoutMacdMonitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@color/card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/tvMacdBadge5m"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="5m: Syncing..."
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMacdBadge15m"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="15m: Syncing..."
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMacdBadge1h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1h: Syncing..."
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Trade Info Levels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/card_bg"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvChartEntry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Entry: $0.0058"
            android:textColor="@color/primary_cyan"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvChartTp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TP: $0.0056 (+4%)"
            android:textColor="@color/neon_green"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvChartSl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SL: $0.0059 (-2%)"
            android:textColor="@color/neon_red"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Candlestick + CVD WebView Chart Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="8dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <WebView
            android:id="@+id/webViewChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClosePosition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/neon_red"
            android:text="🛑 Close Position Now"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismissChart"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dismiss"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
